<UserControl
    x:Class="Ligase.Host.Desktop.Controls.SteamGameResultCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        AutomationProperties.Name="{Binding Result.CardAccessibleName, ElementName=Root}"
        Style="{StaticResource LigaseGameCardStyle}">
        <Grid x:Name="LayoutGrid" ColumnSpacing="14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ActionPanel.(Grid.Row)" Value="1" />
                            <Setter Target="ActionPanel.(Grid.Column)" Value="0" />
                            <Setter Target="ActionPanel.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="760" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ActionPanel.(Grid.Row)" Value="0" />
                            <Setter Target="ActionPanel.(Grid.Column)" Value="1" />
                            <Setter Target="ActionPanel.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level3"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding Result.Name, ElementName=Root}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Grid.Column="1"
                        Padding="8,3"
                        Background="{ThemeResource LigaseAccentSubtleBrush}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ProgressRing
                                Width="12"
                                Height="12"
                                IsActive="{Binding Result.IsBusy, ElementName=Root}"
                                Visibility="{Binding Result.BusyVisibility, ElementName=Root}" />
                            <FontIcon
                                FontSize="11"
                                Foreground="{ThemeResource LigaseAccentTextBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{Binding Result.AddedVisibility, ElementName=Root}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource LigaseAccentTextBrush}"
                                Style="{StaticResource LigaseCaptionTextStyle}"
                                Text="{Binding Result.StatusText, ElementName=Root}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding Result.InstallPath, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        Style="{StaticResource LigaseCaptionTextStyle}"
                        Text="{Binding Result.AppIdLabel, ElementName=Root}" />
                    <TextBlock
                        Style="{StaticResource LigaseCaptionTextStyle}"
                        Text="{Binding Result.SizeLabel, ElementName=Root}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="ActionPanel"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="{Binding Result.CoverActionAccessibleName, ElementName=Root}"
                    Click="OnFindCover"
                    Content="选封面"
                    IsEnabled="{Binding Result.CanMutate, ElementName=Root}"
                    Style="{StaticResource LigaseSecondaryButtonStyle}" />
                <Button
                    AutomationProperties.Name="{Binding Result.AddActionAccessibleName, ElementName=Root}"
                    Click="OnAdd"
                    IsEnabled="{Binding Result.CanMutate, ElementName=Root}"
                    Style="{StaticResource LigaseQuietButtonStyle}"
                    Visibility="{Binding Result.AddVisibility, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                        <TextBlock Text="添加" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{Binding Result.RemoveActionAccessibleName, ElementName=Root}"
                    Click="OnRemove"
                    IsEnabled="{Binding Result.CanMutate, ElementName=Root}"
                    Style="{StaticResource LigaseDangerButtonStyle}"
                    Visibility="{Binding Result.RemoveVisibility, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                        <TextBlock Text="移除" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
