<Page
    x:Class="Ligase.Host.Desktop.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Ligase.Host.Desktop.ViewModels">
    <Grid>
        <ScrollViewer>
            <Grid Margin="32,28,32,40" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource LigaseEyebrowTextStyle}" Text="PAIRED CLIENTS" />
                        <TextBlock Style="{StaticResource LigasePageTitleStyle}" Text="设备" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="查看已经与 Ligase Host 配对的客户端及当前连接状态。" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnRefresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Spacing="10">
                    <StackPanel
                        Spacing="10"
                        Visibility="{x:Bind PairingViewModel.PendingVisibility, Mode=OneWay}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="待批准设备" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="请在电脑和 Android 设备上核对相同安全码，再选择允许。" />
                        </StackPanel>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind PairingViewModel.NotificationWarning, Mode=OneWay}"
                            Severity="Warning"
                            Title="系统通知不可用"
                            Visibility="{x:Bind PairingViewModel.NotificationWarningVisibility, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind PairingViewModel.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:PendingPairingCard">
                                <Border
                                    AutomationProperties.Name="{Binding DeviceName}"
                                    Style="{StaticResource LigaseCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DeviceName}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Platform}" />
                                            <TextBlock
                                                FontFamily="Cascadia Mono"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Text="{Binding SafetyCode}" />
                                            <TextBlock Text="{Binding StateText}" />
                                            <CheckBox
                                                AutomationProperties.Name="仅观察"
                                                Content="仅观察（不能控制电脑、启动或结束游戏，也不能修改 Host 设置）"
                                                IsChecked="{Binding ObserveOnly, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock
                                                    Style="{StaticResource LigaseCaptionTextStyle}"
                                                    Text="{Binding SourceText}" />
                                                <TextBlock
                                                    Style="{StaticResource LigaseCaptionTextStyle}"
                                                    Text="{Binding RemainingText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border
                                            Width="4"
                                            Margin="-14,-14,0,-14"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource LigaseBrandPrimaryBrush}"
                                            CornerRadius="2"
                                            Visibility="{Binding SelectionVisibility}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                AutomationProperties.Name="拒绝配对"
                                                Click="OnReject"
                                                Content="拒绝"
                                                Tag="{Binding RequestId}" />
                                            <Button
                                                AutomationProperties.Name="允许配对"
                                                Click="OnAllow"
                                                Content="允许"
                                                IsEnabled="{Binding AllowEnabled}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{Binding RequestId}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <InfoBar
                            IsClosable="True"
                            IsOpen="True"
                            Message="{x:Bind PairingViewModel.FeedbackMessage, Mode=OneWay}"
                            Severity="Informational"
                            Visibility="{x:Bind PairingViewModel.FeedbackVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind PairingViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Warning"
                        Title="一键配对暂不可用"
                        Visibility="{x:Bind PairingViewModel.ErrorVisibility, Mode=OneWay}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DeviceCard">
                                <Border Style="{StaticResource LigaseCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{ThemeResource LigaseCyanSubtleBrush}"
                                            CornerRadius="12">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource LigaseCyanBrush}"
                                                Glyph="&#xE8BE;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind DisplayMode}" />
                                            <TextBlock
                                                Style="{StaticResource LigaseCaptionTextStyle}"
                                                Text="{x:Bind Permission}" />
                                            <TextBlock
                                                FontFamily="Cascadia Mono"
                                                Style="{StaticResource LigaseCaptionTextStyle}"
                                                Text="{x:Bind Uuid}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Spacing="8">
                                            <Border
                                                Height="28"
                                                Padding="10,0"
                                                Background="{ThemeResource LigaseSuccessSubtleBrush}"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontSize="12"
                                                        Foreground="{ThemeResource LigaseSuccessBrush}"
                                                        Glyph="{x:Bind StatusGlyph}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource LigaseSuccessBrush}"
                                                        Text="{x:Bind Status}" />
                                                </StackPanel>
                                            </Border>
                                            <Button
                                                AutomationProperties.Name="管理设备"
                                                Click="OnManageDevice"
                                                Content="管理"
                                                Tag="{x:Bind Uuid}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8BE;" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="还没有已配对设备" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在 Android 客户端添加这台主机并完成 PIN 配对后，设备会显示在这里。" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        Title="无法读取设备"
                        Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
