<Page
    x:Class="Ligase.Host.Desktop.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16">
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="LIGASE HOST" />
                    <TextBlock
                        x:Name="WelcomeTitleText"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="欢迎回来" />
                    <TextBlock
                        x:Name="CoreSummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在读取 Host 状态"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="打开游戏库"
                        Click="OnOpenLibrary"
                        Content="打开游戏库" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="StatusMessageText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="220"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <StackPanel Spacing="5">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="串流核心" />
                        <TextBlock x:Name="CoreValueText" FontSize="22" FontWeight="SemiBold" Text="读取中" />
                    </StackPanel>
                </Border>
                <Border
                    Width="220"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <StackPanel Spacing="5">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="游戏库" />
                        <TextBlock x:Name="LibraryValueText" FontSize="22" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border
                    Width="220"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <StackPanel Spacing="5">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="配对设备" />
                        <TextBlock x:Name="DeviceValueText" FontSize="22" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border
                    Width="220"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <StackPanel Spacing="5">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="虚拟桌面" />
                        <TextBlock x:Name="VirtualDisplayValueText" FontSize="22" FontWeight="SemiBold" Text="读取中" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="最近项目" />
                    <TextBlock
                        x:Name="RecentSummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在读取最近项目"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="快捷操作" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnAddGame" Content="添加游戏或应用" />
                        <Button Click="OnOpenMonitor" Content="打开串流监控" />
                        <Button Click="OnOpenDevices" Content="管理配对设备" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
