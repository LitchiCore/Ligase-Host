<Page
    x:Class="Ligase.Host.Desktop.Pages.AddApplicationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ligase.Host.Desktop.Controls"
    xmlns:models="using:Ligase.Host.Core.Models"
    xmlns:viewModels="using:Ligase.Host.Desktop.ViewModels">
    <Grid
        x:Name="PageLayout"
        Margin="28,24,28,28"
        Background="{ThemeResource LigaseWindowBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageLayout.Margin" Value="16,16,16,20" />
                        <Setter Target="CoverSearchButton.(Grid.Row)" Value="1" />
                        <Setter Target="CoverSearchButton.(Grid.Column)" Value="0" />
                        <Setter Target="CoverSearchButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CoverSearchButton.Margin" Value="0,10,0,0" />
                        <Setter Target="SteamScanButton.(Grid.Row)" Value="1" />
                        <Setter Target="SteamScanButton.(Grid.Column)" Value="0" />
                        <Setter Target="SteamScanButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="SteamScanButton.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeroHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Width="40"
                Height="40"
                Click="OnBack"
                Style="{StaticResource LigaseSecondaryButtonStyle}"
                ToolTipService.ToolTip="返回游戏库">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                <TextBlock Style="{StaticResource LigaseEyebrowTextStyle}" Text="LIBRARY / ADD" />
                <TextBlock Style="{StaticResource LigasePageTitleStyle}" Text="添加游戏或应用" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Steam 游戏会启用生命周期监控；其他程序直接由 Apollo 启动和跟踪。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="Informational"
            Title="添加结果" />

        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasAuthorityWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.AuthorityMessage, Mode=OneWay}"
            Severity="Warning"
            Title="游戏库暂时只读" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
        <Border
            x:Name="CoverSearchPanel"
            Style="{StaticResource LigaseToolbarStyle}">
            <StackPanel Spacing="10">
                <Grid x:Name="CoverSearchGrid" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        PlaceholderText="非 Steam 应用封面名称（Steam 封面只按已验证 App ID）"
                        Text="{x:Bind ViewModel.CoverSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Name="CoverSearchButton"
                        Grid.Column="1"
                        Click="OnSearchCovers"
                        Style="{StaticResource LigaseSecondaryButtonStyle}"
                        Content="搜索 / 更换封面" />
                </Grid>
                <ListView
                    MaxHeight="190"
                    ItemsSource="{x:Bind ViewModel.CoverCandidates, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoverCandidate">
                            <Button
                                Width="112"
                                Margin="0,0,8,0"
                                Padding="6"
                                Click="OnSelectCover"
                                Tag="{x:Bind}"
                                Style="{StaticResource LigaseSecondaryButtonStyle}">
                                <StackPanel Spacing="5">
                                    <Image
                                        Width="96"
                                        Height="128"
                                        Source="{x:Bind PreviewUrl}"
                                        Stretch="UniformToFill" />
                                    <TextBlock
                                        MaxWidth="96"
                                        FontSize="11"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxWidth="96"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SourceId}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.HelpText="现有游戏仅在库和同步回读成功后显示保存成功"
                        AutomationProperties.Name="保存封面更改"
                        Click="OnSaveCoverSelection"
                        Content="保存封面"
                        IsEnabled="{x:Bind ViewModel.CanSaveCoverSelection, Mode=OneWay}"
                        Style="{StaticResource LigaseQuietButtonStyle}" />
                    <Button
                        AutomationProperties.Name="预览默认封面"
                        Click="OnPreviewDefaultCover"
                        Content="使用默认封面"
                        Style="{StaticResource LigaseSecondaryButtonStyle}" />
                    <Button
                        AutomationProperties.Name="取消封面更改"
                        Click="OnCancelCoverSelection"
                        Content="取消"
                        Style="{StaticResource LigaseSecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border
            x:Name="CompactHeader"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource LigaseToolbarStyle}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="返回游戏库"
                    Click="OnBack"
                    Content="返回" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.HelpText="将键盘焦点移动到 Steam 游戏搜索框"
                    AutomationProperties.Name="搜索 Steam 游戏"
                    Click="OnFocusSteamSearch"
                    Content="搜索"
                    Style="{StaticResource LigaseSecondaryButtonStyle}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="展开添加游戏工具"
                    Click="OnExpandChrome"
                    Content="展开工具"
                    Style="{StaticResource LigaseSecondaryButtonStyle}" />
            </Grid>
        </Border>
        </Grid>

        <TabView
            Grid.Row="4"
            Margin="0,18,0,0"
            IsAddTabButtonVisible="False">
            <TabViewItem Header="Steam 游戏" IconSource="{StaticResource SteamTabIcon}" IsClosable="False">
                <Grid Padding="2,16,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource LigaseToolbarStyle}">
                        <Grid x:Name="SteamSearchGrid" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    x:Name="SteamGameSearchLabel"
                                    FontWeight="SemiBold"
                                    Text="搜索 Steam 游戏" />
                                <AutoSuggestBox
                                    x:Name="SteamGameSearchBox"
                                    AutomationProperties.HelpText="按 Steam 游戏名称、App ID 或安装目录筛选结果"
                                    AutomationProperties.LabeledBy="{Binding ElementName=SteamGameSearchLabel}"
                                    AutomationProperties.Name="搜索 Steam 游戏"
                                    IsTabStop="True"
                                    Loaded="OnSteamGameSearchLoaded"
                                    PlaceholderText="搜索 Steam 名称、App ID 或目录"
                                    QueryIcon="Find"
                                    Style="{StaticResource LigaseSearchBoxStyle}"
                                    TabIndex="0"
                                    Text="{x:Bind ViewModel.SteamSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                x:Name="SteamScanButton"
                                Grid.Column="1"
                                AutomationProperties.Name="重新扫描 Steam 游戏库"
                                VerticalAlignment="Bottom"
                                Click="OnScanSteam"
                                Style="{StaticResource LigaseSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    <TextBlock Text="重新扫描" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ProgressBar
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}" />
                    <ScrollViewer
                        x:Name="SteamResultsScrollViewer"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        ViewChanged="OnSteamResultsViewChanged"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="可添加"
                                Visibility="{x:Bind ViewModel.SteamResults.AvailableVisibility, Mode=OneWay}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.SteamResults.AvailableGames, Mode=OneWay}"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None"
                                Visibility="{x:Bind ViewModel.SteamResults.AvailableVisibility, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SteamGameResultViewModel">
                                        <controls:SteamGameResultCard
                                            Result="{x:Bind}"
                                            AddRequested="OnAddSteam"
                                            FindCoverRequested="OnFindSteamCover"
                                            RemoveRequested="OnRemoveSteam" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                Margin="0,6,0,0"
                                Spacing="3"
                                Visibility="{x:Bind ViewModel.SteamResults.AddedVisibility, Mode=OneWay}">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="已添加" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="这些游戏已在 Host 和客户端游戏库中。移除只会删除游戏库记录，不会删除 Steam 文件。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.SteamResults.AddedGames, Mode=OneWay}"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None"
                                Visibility="{x:Bind ViewModel.SteamResults.AddedVisibility, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SteamGameResultViewModel">
                                        <controls:SteamGameResultCard
                                            Result="{x:Bind}"
                                            AddRequested="OnAddSteam"
                                            FindCoverRequested="OnFindSteamCover"
                                            RemoveRequested="OnRemoveSteam" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Margin="4,24"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="没有符合当前搜索条件的 Steam 游戏。请缩短关键词或重新扫描。"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.SteamResults.EmptyVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="非 Steam 应用" IsClosable="False">
                <ScrollViewer Padding="2,16,2,0">
                    <Border
                        MaxWidth="760"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LigaseCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="添加本地程序" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="可选择 EXE 手动填写，也可拖入一个 .lnk，核对安全预览后再确认添加。拖入本身不会修改游戏库。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                x:Name="ShortcutDropZone"
                                MinHeight="96"
                                AllowDrop="True"
                                AutomationProperties.HelpText="拖入一个本机 Windows 快捷方式，或使用按钮通过键盘选择"
                                AutomationProperties.Name="预览 Windows 快捷方式"
                                BorderBrush="{ThemeResource LigaseBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                DragOver="OnShortcutDragOver"
                                Drop="OnShortcutDrop"
                                Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="拖入一个 .lnk 以安全预览" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="不会执行快捷方式，也不会在确认前写入游戏库。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="选择 Windows 快捷方式进行预览"
                                        Click="OnBrowseShortcut"
                                        Content="选择 .lnk…"
                                        Style="{StaticResource LigaseSecondaryButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource LigaseToolbarStyle}"
                                Visibility="{x:Bind ViewModel.ShortcutPreviewVisibility, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="快捷方式预览（尚未添加）" />
                                    <TextBlock Text="{x:Bind ViewModel.ShortcutPreview.DisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        Text="{x:Bind ViewModel.ShortcutPreview.TargetExecutable, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.ShortcutPreview.Arguments, Mode=OneWay, TargetNullValue=无启动参数}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.ShortcutPreview.WorkingDirectory, Mode=OneWay, TargetNullValue=使用程序所在目录}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.ShortcutPreview.IconSource, Mode=OneWay, TargetNullValue=使用程序图标}" TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            AutomationProperties.Name="确认将预览的快捷方式加入游戏库"
                                            Click="OnConfirmShortcut"
                                            Content="确认添加"
                                            IsEnabled="{x:Bind ViewModel.CanConfirmShortcut, Mode=OneWay}"
                                            Style="{StaticResource LigaseQuietButtonStyle}" />
                                        <Button
                                            AutomationProperties.Name="取消快捷方式预览"
                                            Click="OnCancelShortcut"
                                            Content="取消"
                                            Style="{StaticResource LigaseSecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="显示名称" />
                                <TextBox
                                    PlaceholderText="例如：Blender"
                                    Text="{x:Bind ViewModel.ApplicationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="程序路径" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="C:\Program Files\App\App.exe"
                                        Text="{x:Bind ViewModel.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnBrowseExecutable"
                                        Style="{StaticResource LigaseSecondaryButtonStyle}"
                                        Content="浏览…" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="启动参数（可选）" />
                                <TextBox
                                    PlaceholderText="--fullscreen"
                                    Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="工作目录（可选）" />
                                <TextBox Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.CanModifyLibrary, Mode=OneWay}"
                                Click="OnAddExecutable"
                                Style="{StaticResource LigaseQuietButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                                    <TextBlock Text="添加到游戏库" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
