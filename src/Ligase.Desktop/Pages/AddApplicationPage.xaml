<Page
    x:Class="Ligase.Host.Desktop.Pages.AddApplicationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ligase.Host.Core.Models">
    <Grid Margin="28,24,28,28" Background="{ThemeResource LigaseWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Width="40"
                Height="40"
                Click="OnBack"
                Style="{StaticResource LigaseSecondaryButtonStyle}"
                ToolTipService.ToolTip="返回游戏库">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                <TextBlock Style="{StaticResource LigaseEyebrowTextStyle}" Text="LIBRARY / ADD" />
                <TextBlock Style="{StaticResource LigasePageTitleStyle}" Text="添加游戏或应用" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Steam 游戏会启用生命周期监控；其他程序直接由 Apollo 启动和跟踪。" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="0,16,0,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="Informational"
            Title="添加结果" />

        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasAuthorityWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.AuthorityMessage, Mode=OneWay}"
            Severity="Warning"
            Title="游戏库暂时只读" />

        <Border
            Grid.Row="3"
            Margin="0,14,0,0"
            Style="{StaticResource LigaseToolbarStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        PlaceholderText="封面名称（留空时添加会按游戏名称自动匹配第一张）"
                        Text="{x:Bind ViewModel.CoverSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Click="OnSearchCovers"
                        Style="{StaticResource LigaseSecondaryButtonStyle}"
                        Content="搜索 / 更换封面" />
                </Grid>
                <ListView
                    MaxHeight="190"
                    ItemsSource="{x:Bind ViewModel.CoverCandidates, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoverCandidate">
                            <Button
                                Width="112"
                                Margin="0,0,8,0"
                                Padding="6"
                                Click="OnSelectCover"
                                Tag="{x:Bind}"
                                Style="{StaticResource LigaseSecondaryButtonStyle}">
                                <StackPanel Spacing="5">
                                    <Image
                                        Width="96"
                                        Height="128"
                                        Source="{x:Bind PreviewUrl}"
                                        Stretch="UniformToFill" />
                                    <TextBlock
                                        MaxWidth="96"
                                        FontSize="11"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <TabView
            Grid.Row="4"
            Margin="0,18,0,0"
            IsAddTabButtonVisible="False">
            <TabViewItem Header="Steam 游戏" IconSource="{StaticResource SteamTabIcon}" IsClosable="False">
                <Grid Padding="2,16,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource LigaseToolbarStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                PlaceholderText="搜索 Steam 名称、App ID 或目录"
                                QueryIcon="Find"
                                Style="{StaticResource LigaseSearchBoxStyle}"
                                Text="{x:Bind ViewModel.SteamSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Click="OnScanSteam"
                                Style="{StaticResource LigaseSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    <TextBlock Text="重新扫描" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ProgressBar
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}" />
                    <ListView
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        ItemsSource="{x:Bind ViewModel.SteamGames, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SteamGame">
                                <Border Style="{StaticResource LigaseGameCardStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind InstallPath}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Style="{StaticResource LigaseCaptionTextStyle}" Text="{x:Bind AppIdLabel}" />
                                                <TextBlock Style="{StaticResource LigaseCaptionTextStyle}" Text="{x:Bind SizeLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Tag="{x:Bind}"
                                                Click="OnFindSteamCover"
                                                Style="{StaticResource LigaseSecondaryButtonStyle}"
                                                Content="选封面" />
                                            <Button
                                                Tag="{x:Bind}"
                                                IsEnabled="{Binding ViewModel.CanModifyLibrary, ElementName=RootPage}"
                                                Click="OnAddSteam"
                                                Style="{StaticResource LigaseQuietButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                                                    <TextBlock Text="添加" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="非 Steam 应用" IsClosable="False">
                <ScrollViewer Padding="2,16,2,0">
                    <Border Width="760" HorizontalAlignment="Left" Style="{StaticResource LigaseCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="添加本地程序" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="选择 EXE，并按需填写启动参数与工作目录。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="显示名称" />
                                <TextBox
                                    PlaceholderText="例如：Blender"
                                    Text="{x:Bind ViewModel.ApplicationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="程序路径" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        PlaceholderText="C:\Program Files\App\App.exe"
                                        Text="{x:Bind ViewModel.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnBrowseExecutable"
                                        Style="{StaticResource LigaseSecondaryButtonStyle}"
                                        Content="浏览…" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="启动参数（可选）" />
                                <TextBox
                                    PlaceholderText="--fullscreen"
                                    Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="工作目录（可选）" />
                                <TextBox Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.CanModifyLibrary, Mode=OneWay}"
                                Click="OnAddExecutable"
                                Style="{StaticResource LigaseQuietButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                                    <TextBlock Text="添加到游戏库" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
