<Page
    x:Class="Ligase.Host.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Margin="32,28,32,40" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource LigaseEyebrowTextStyle}" Text="HOST BEHAVIOR" />
                <TextBlock x:Uid="SettingsTitle" Style="{StaticResource LigasePageTitleStyle}" Text="设置" />
                <TextBlock
                    x:Uid="SettingsDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="控制 Ligase Host 的后台运行、Windows 启动行为和显示语言。" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource LigaseCardStyle}">
                <StackPanel Spacing="4">
                    <Grid Padding="4,8" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="CloseToTrayTitle" FontSize="16" FontWeight="SemiBold" Text="关闭窗口后在后台运行" />
                            <TextBlock
                                x:Uid="CloseToTrayDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="点击关闭按钮时隐藏到系统托盘，并保持 Apollo 串流核心运行。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Uid="CloseToTrayToggle"
                            x:Name="CloseToTrayToggle"
                            Grid.Column="1"
                            AutomationProperties.Name="关闭窗口后在后台运行"
                            Toggled="OnCloseToTrayToggled" />
                    </Grid>
                    <Rectangle Height="1" Margin="4,8" Fill="{ThemeResource LigaseCardStrokeBrush}" />
                    <Grid Padding="4,8" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StartWithWindowsTitle" FontSize="16" FontWeight="SemiBold" Text="开机自动启动" />
                            <TextBlock
                                x:Uid="StartWithWindowsDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="登录 Windows 后自动在托盘启动 Ligase Host，不弹出主窗口。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Uid="StartWithWindowsToggle"
                            x:Name="StartWithWindowsToggle"
                            Grid.Column="1"
                            AutomationProperties.Name="开机自动启动"
                            Toggled="OnStartWithWindowsToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource LigaseCardStyle}">
                <Grid Padding="4,8" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="LanguageTitle" FontSize="16" FontWeight="SemiBold" Text="显示语言" />
                        <TextBlock
                            x:Uid="LanguageDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="选择 Ligase Host 界面使用的语言。更改将在下次启动时生效。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnLanguageSelectionChanged">
                        <ComboBoxItem x:Uid="LanguageSystem" Content="跟随系统" />
                        <ComboBoxItem x:Uid="LanguageChinese" Content="简体中文" />
                        <ComboBoxItem x:Uid="LanguageEnglish" Content="English" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource LigaseCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Windows 通知" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="发送一条本机测试通知。点击通知应返回当前 Ligase Host 窗口。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="发送 Windows 测试通知"
                        Click="OnTestNotification"
                        Content="发送测试通知" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource LigaseCardStyle}">
                <StackPanel Spacing="12">
                      <Grid ColumnSpacing="16">
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <VisualStateManager.VisualStateGroups>
                              <VisualStateGroup>
                                  <VisualState>
                                      <VisualState.StateTriggers>
                                          <AdaptiveTrigger MinWindowWidth="760" />
                                      </VisualState.StateTriggers>
                                  </VisualState>
                                  <VisualState>
                                      <VisualState.StateTriggers>
                                          <AdaptiveTrigger MinWindowWidth="0" />
                                      </VisualState.StateTriggers>
                                      <VisualState.Setters>
                                          <Setter Target="ConfigureFirewallButton.(Grid.Row)" Value="1" />
                                          <Setter Target="ConfigureFirewallButton.(Grid.Column)" Value="0" />
                                          <Setter Target="ConfigureFirewallButton.HorizontalAlignment" Value="Left" />
                                          <Setter Target="ConfigureFirewallButton.Margin" Value="0,12,0,0" />
                                      </VisualState.Setters>
                                  </VisualState>
                              </VisualStateGroup>
                          </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="局域网访问" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="仅允许 Private 局域网的 LocalSubnet 通过 IPv4/IPv6 访问串流服务；不会开放管理端口，也不会关闭 Windows 防火墙。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                              x:Name="ConfigureFirewallButton"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                            AutomationProperties.Name="配置 Ligase Host 局域网访问"
                            Click="OnConfigureFirewall"
                            Content="{x:Bind FirewallViewModel.ActionLabel, Mode=OneWay}" />
                    </Grid>
                    <InfoBar
                        x:Name="FirewallStatusBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind FirewallViewModel.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind FirewallViewModel.Severity, Mode=OneWay}"
                        Title="{x:Bind FirewallViewModel.StatusTitle, Mode=OneWay}" />
                    <Expander Header="高级信息">
                        <StackPanel Padding="0,8,0,0" Spacing="5">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind FirewallViewModel.PortSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind FirewallViewModel.AuditSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource LigaseCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="22"
                        Foreground="{ThemeResource LigaseWarningBrush}"
                        Glyph="&#xE74E;" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Uid="ExitTitle" FontWeight="SemiBold" Text="如何彻底退出" />
                        <TextBlock
                            x:Uid="ExitDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="右键任务栏通知区域的 Ligase Host 图标，选择“退出 Ligase Host”。彻底退出会停止 Ligase 的独立 Apollo 核心。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SaveStatusText"
                            Foreground="{ThemeResource LigaseSuccessBrush}"
                            Style="{StaticResource LigaseCaptionTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Uid="ExitButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="彻底退出 Ligase Host"
                        Click="OnExitApplication"
                        Content="退出 Ligase Host"
                        BorderBrush="{ThemeResource LigaseErrorDangerBrush}"
                        Foreground="{ThemeResource LigaseErrorDangerBrush}"
                        Style="{StaticResource LigaseSecondaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
