<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- Default mirrors Light because Ligase starts in the system theme and
             WinUI resolves Default before the first explicit theme switch. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="LigaseBrandPrimaryColor">#6258D9</Color>
            <Color x:Key="LigaseBrandSecondaryColor">#08788B</Color>
            <Color x:Key="LigaseBackgroundColor">#F5F7FC</Color>
            <Color x:Key="LigaseSurfaceColor">#FFFFFF</Color>
            <Color x:Key="LigaseSurfaceVariantColor">#EEF2F8</Color>
            <Color x:Key="LigaseTextPrimaryColor">#20232C</Color>
            <Color x:Key="LigaseTextSecondaryColor">#555D6D</Color>
            <Color x:Key="LigaseBorderColor">#8B94A5</Color>
            <Color x:Key="LigaseSelectedColor">#E7E5FF</Color>
            <Color x:Key="LigaseSuccessColor">#13795B</Color>
            <Color x:Key="LigaseWarningColor">#8A4F00</Color>
            <Color x:Key="LigaseErrorDangerColor">#B42318</Color>
            <Color x:Key="LigaseDisabledColor">#555D6D</Color>
            <Color x:Key="LigaseFocusColor">#4F46C7</Color>

            <SolidColorBrush x:Key="LigaseBrandPrimaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseBrandSecondaryBrush" Color="{ThemeResource LigaseBrandSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBackgroundBrush" Color="{ThemeResource LigaseBackgroundColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceBrush" Color="{ThemeResource LigaseSurfaceColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceVariantBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
            <SolidColorBrush x:Key="LigaseTextPrimaryBrush" Color="{ThemeResource LigaseTextPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseTextSecondaryBrush" Color="{ThemeResource LigaseTextSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBorderBrush" Color="{ThemeResource LigaseBorderColor}" />
            <SolidColorBrush x:Key="LigaseSelectedBrush" Color="{ThemeResource LigaseSelectedColor}" />
            <SolidColorBrush x:Key="LigaseSuccessBrush" Color="{ThemeResource LigaseSuccessColor}" />
            <SolidColorBrush x:Key="LigaseWarningBrush" Color="{ThemeResource LigaseWarningColor}" />
            <SolidColorBrush x:Key="LigaseErrorDangerBrush" Color="{ThemeResource LigaseErrorDangerColor}" />
            <SolidColorBrush x:Key="LigaseDisabledBrush" Color="{ThemeResource LigaseDisabledColor}" />
            <SolidColorBrush x:Key="LigaseFocusBrush" Color="{ThemeResource LigaseFocusColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="LigaseBrandPrimaryColor">#6258D9</Color>
            <Color x:Key="LigaseBrandSecondaryColor">#08788B</Color>
            <Color x:Key="LigaseBackgroundColor">#F5F7FC</Color>
            <Color x:Key="LigaseSurfaceColor">#FFFFFF</Color>
            <Color x:Key="LigaseSurfaceVariantColor">#EEF2F8</Color>
            <Color x:Key="LigaseTextPrimaryColor">#20232C</Color>
            <Color x:Key="LigaseTextSecondaryColor">#555D6D</Color>
            <Color x:Key="LigaseBorderColor">#8B94A5</Color>
            <Color x:Key="LigaseSelectedColor">#E7E5FF</Color>
            <Color x:Key="LigaseSuccessColor">#13795B</Color>
            <Color x:Key="LigaseWarningColor">#8A4F00</Color>
            <Color x:Key="LigaseErrorDangerColor">#B42318</Color>
            <Color x:Key="LigaseDisabledColor">#555D6D</Color>
            <Color x:Key="LigaseFocusColor">#4F46C7</Color>

            <SolidColorBrush x:Key="LigaseBrandPrimaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseBrandSecondaryBrush" Color="{ThemeResource LigaseBrandSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBackgroundBrush" Color="{ThemeResource LigaseBackgroundColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceBrush" Color="{ThemeResource LigaseSurfaceColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceVariantBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
            <SolidColorBrush x:Key="LigaseTextPrimaryBrush" Color="{ThemeResource LigaseTextPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseTextSecondaryBrush" Color="{ThemeResource LigaseTextSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBorderBrush" Color="{ThemeResource LigaseBorderColor}" />
            <SolidColorBrush x:Key="LigaseSelectedBrush" Color="{ThemeResource LigaseSelectedColor}" />
            <SolidColorBrush x:Key="LigaseSuccessBrush" Color="{ThemeResource LigaseSuccessColor}" />
            <SolidColorBrush x:Key="LigaseWarningBrush" Color="{ThemeResource LigaseWarningColor}" />
            <SolidColorBrush x:Key="LigaseErrorDangerBrush" Color="{ThemeResource LigaseErrorDangerColor}" />
            <SolidColorBrush x:Key="LigaseDisabledBrush" Color="{ThemeResource LigaseDisabledColor}" />
            <SolidColorBrush x:Key="LigaseFocusBrush" Color="{ThemeResource LigaseFocusColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="LigaseBrandPrimaryColor">#B8B1FF</Color>
            <Color x:Key="LigaseBrandSecondaryColor">#6ED6E4</Color>
            <Color x:Key="LigaseBackgroundColor">#15171D</Color>
            <Color x:Key="LigaseSurfaceColor">#20232C</Color>
            <Color x:Key="LigaseSurfaceVariantColor">#2A2E39</Color>
            <Color x:Key="LigaseTextPrimaryColor">#F5F7FB</Color>
            <Color x:Key="LigaseTextSecondaryColor">#B8C0CE</Color>
            <Color x:Key="LigaseBorderColor">#747D8E</Color>
            <Color x:Key="LigaseSelectedColor">#35315C</Color>
            <Color x:Key="LigaseSuccessColor">#56D19B</Color>
            <Color x:Key="LigaseWarningColor">#F4B860</Color>
            <Color x:Key="LigaseErrorDangerColor">#FF7B72</Color>
            <Color x:Key="LigaseDisabledColor">#B8C0CE</Color>
            <Color x:Key="LigaseFocusColor">#B8B1FF</Color>

            <SolidColorBrush x:Key="LigaseBrandPrimaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseBrandSecondaryBrush" Color="{ThemeResource LigaseBrandSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBackgroundBrush" Color="{ThemeResource LigaseBackgroundColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceBrush" Color="{ThemeResource LigaseSurfaceColor}" />
            <SolidColorBrush x:Key="LigaseSurfaceVariantBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
            <SolidColorBrush x:Key="LigaseTextPrimaryBrush" Color="{ThemeResource LigaseTextPrimaryColor}" />
            <SolidColorBrush x:Key="LigaseTextSecondaryBrush" Color="{ThemeResource LigaseTextSecondaryColor}" />
            <SolidColorBrush x:Key="LigaseBorderBrush" Color="{ThemeResource LigaseBorderColor}" />
            <SolidColorBrush x:Key="LigaseSelectedBrush" Color="{ThemeResource LigaseSelectedColor}" />
            <SolidColorBrush x:Key="LigaseSuccessBrush" Color="{ThemeResource LigaseSuccessColor}" />
            <SolidColorBrush x:Key="LigaseWarningBrush" Color="{ThemeResource LigaseWarningColor}" />
            <SolidColorBrush x:Key="LigaseErrorDangerBrush" Color="{ThemeResource LigaseErrorDangerColor}" />
            <SolidColorBrush x:Key="LigaseDisabledBrush" Color="{ThemeResource LigaseDisabledColor}" />
            <SolidColorBrush x:Key="LigaseFocusBrush" Color="{ThemeResource LigaseFocusColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="LigaseOnBrandBrush" Color="{ThemeResource LigaseSurfaceColor}" />

    <!-- WinUI/component aliases. These contain no independent color values. -->
    <SolidColorBrush x:Key="LigaseWindowBrush" Color="{ThemeResource LigaseBackgroundColor}" />
    <SolidColorBrush x:Key="LigasePaneBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="LigaseTitleBarBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="LigaseSurfaceMutedBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="LigaseCardBrush" Color="{ThemeResource LigaseSurfaceColor}" />
    <SolidColorBrush x:Key="LigaseCardStrokeBrush" Color="{ThemeResource LigaseBorderColor}" />
    <SolidColorBrush x:Key="LigaseDividerBrush" Color="{ThemeResource LigaseBorderColor}" />
    <SolidColorBrush x:Key="LigaseAccentBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="LigaseAccentSubtleBrush" Color="{ThemeResource LigaseSelectedColor}" />
    <SolidColorBrush x:Key="LigaseAccentTextBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="LigaseCyanBrush" Color="{ThemeResource LigaseBrandSecondaryColor}" />
    <SolidColorBrush x:Key="LigaseCyanSubtleBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="LigaseSuccessSubtleBrush" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="LigaseGameTileBrush" Color="{ThemeResource LigaseSelectedColor}" />
    <SolidColorBrush x:Key="LigaseGameTileStrokeBrush" Color="{ThemeResource LigaseBorderColor}" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource LigaseBrandPrimaryColor}" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource LigaseSelectedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource LigaseTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource LigaseTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource LigaseTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource LigaseTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{ThemeResource LigaseDisabledColor}" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource LigaseFocusColor}" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource LigaseSurfaceColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{ThemeResource LigaseFocusColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{ThemeResource LigaseSurfaceColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{ThemeResource LigaseFocusColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{ThemeResource LigaseSurfaceColor}" />

    <LinearGradientBrush x:Key="LigaseAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{ThemeResource LigaseBrandPrimaryColor}" />
        <GradientStop Offset="1" Color="{ThemeResource LigaseBrandSecondaryColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LigaseHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{ThemeResource LigaseSelectedColor}" />
        <GradientStop Offset="1" Color="{ThemeResource LigaseSurfaceVariantColor}" />
    </LinearGradientBrush>
</ResourceDictionary>
