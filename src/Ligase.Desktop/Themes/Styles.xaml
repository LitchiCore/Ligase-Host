<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LigasePageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LigaseTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LigaseEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="110" />
        <Setter Property="Foreground" Value="{ThemeResource LigaseAccentTextBrush}" />
    </Style>

    <Style x:Key="LigaseCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource LigaseTextSecondaryBrush}" />
    </Style>

    <Style x:Key="LigaseCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LigaseCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LigaseCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style
        x:Key="LigaseGameCardStyle"
        BasedOn="{StaticResource LigaseCardStyle}"
        TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style
        x:Key="LigaseToolbarStyle"
        BasedOn="{StaticResource LigaseCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LigaseSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="LigaseSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="LigaseSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{ThemeResource LigaseSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LigaseCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource LigaseTextPrimaryBrush}" />
    </Style>

    <Style x:Key="LigaseQuietButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{ThemeResource LigaseAccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LigaseAccentTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style
        x:Key="LigaseDangerButtonStyle"
        BasedOn="{StaticResource LigaseSecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource LigaseErrorDangerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LigaseErrorDangerBrush}" />
    </Style>

    <Style x:Key="LigaseTitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource LigaseTextPrimaryBrush}" />
    </Style>

    <Style x:Key="LigaseNavigationViewItemStyle" TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Margin" Value="6,2" />
    </Style>
</ResourceDictionary>
