<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <RootNamespace>Ligase.Host.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ligase.Core\Ligase.Host.Core.csproj" />
    <ProjectReference Include="..\..\tools\Ligase.GameWatcher\Ligase.GameWatcher.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src_assets\windows\misc\firewall\Manage-LigaseFirewall.ps1"
             Link="Firewall\Manage-LigaseFirewall.ps1"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src_assets\windows\misc\firewall\ligase-firewall-v1.json"
             Link="Firewall\ligase-firewall-v1.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <GameWatcherProject>$(MSBuildProjectDirectory)\..\..\tools\Ligase.GameWatcher\Ligase.GameWatcher.csproj</GameWatcherProject>
  </PropertyGroup>
  <Target
    Name="CopyGameWatcher"
    AfterTargets="Build"
    Condition="'$(LigaseStructuredPackage)' != 'true'">
    <MSBuild
      Projects="$(GameWatcherProject)"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_GameWatcherTarget" />
    </MSBuild>
    <PropertyGroup>
      <_GameWatcherSourceDirectory>@(_GameWatcherTarget->'%(RootDir)%(Directory)')</_GameWatcherSourceDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_GameWatcherFiles Include="$(_GameWatcherSourceDirectory)Ligase.GameWatcher.*" />
      <_DeployedGameWatcherFiles Include="$(TargetDir)Ligase.GameWatcher.*" />
    </ItemGroup>
    <Delete
      Condition="'$(_GameWatcherSourceDirectory)' != '$(TargetDir)'"
      Files="@(_DeployedGameWatcherFiles)" />
    <Error
      Condition="'@(_GameWatcherFiles)' == ''"
      Text="The $(Platform) $(Configuration) Ligase.GameWatcher output is missing from '@(_GameWatcherTarget)'." />
    <Copy
      Condition="'$(_GameWatcherSourceDirectory)' != '$(TargetDir)'"
      SourceFiles="@(_GameWatcherFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
  <Target
    Name="CopyLigaseSystemCovers"
    AfterTargets="Build"
    Condition="'$(LigaseStructuredPackage)' != 'true'">
    <ItemGroup>
      <_LigaseSystemCovers Include="$(MSBuildProjectDirectory)\..\..\src_assets\common\assets\desktop.png" />
      <_LigaseSystemCovers Include="$(MSBuildProjectDirectory)\..\..\src_assets\common\assets\desktop-alt.png" />
      <_LigaseSystemCovers Include="$(MSBuildProjectDirectory)\..\..\src_assets\common\assets\virtual_desktop.png" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Apollo\assets" />
    <Copy
      SourceFiles="@(_LigaseSystemCovers)"
      DestinationFolder="$(TargetDir)Apollo\assets"
      SkipUnchangedFiles="true" />
  </Target>
  <Target
    Name="CopyLigaseWinUiResourcesToStructuredPublish"
    AfterTargets="Publish"
    Condition="'$(LigaseStructuredPackage)' == 'true'">
    <ItemGroup>
      <_LigaseWinUiPri Include="$(TargetDir)$(AssemblyName).pri" />
      <_LigaseWinUiXbf Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Error
      Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
      Text="The generated WinUI PRI is missing from '$(TargetDir)$(AssemblyName).pri'." />
    <Error
      Condition="'@(_LigaseWinUiXbf)' == ''"
      Text="The generated WinUI XBF resources are missing from '$(TargetDir)'." />
    <Copy
      SourceFiles="@(_LigaseWinUiPri)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_LigaseWinUiXbf)"
      DestinationFiles="@(_LigaseWinUiXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
