<Page
    x:Class="Ligase.Host.Desktop.Presentation.LayoutCatalog.LayoutCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ligase.Host.Desktop.Presentation.LayoutCatalog">
    <Grid
        x:Name="PageRoot"
        Padding="24"
        SizeChanged="OnRootSizeChanged">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="LAYOUT CATALOG" />
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="布局大厅" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="查看 Host 本机登记的布局描述、兼容范围和显式绑定。这里不会读取或编辑布局内容。"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="刷新布局目录"
                    Click="OnRefresh"
                    Content="刷新"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid
                x:Name="MasterDetailGrid"
                Grid.Row="1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="360" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="BindingAlertBar"
                        Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="部分显式绑定需要处理" />
                    <ListView
                        x:Name="DescriptorList"
                        Grid.Row="1"
                        AutomationProperties.Name="已安装布局描述"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectionChanged="OnDescriptorSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LayoutCatalogDescriptorCard">
                                <Border
                                    Padding="16"
                                    AutomationProperties.Name="{x:Bind AutomationSummary}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Spacing="7">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind LayoutId}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind PublicationStatusLabel}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind RevisionLabel}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind CompatibilitySummary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind VariantSummary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind BindingSummary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyState"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460"
                        Spacing="10"
                        Visibility="Collapsed">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Glyph="&#xECA5;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="布局目录还是空的" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Host 目前没有登记任何布局描述。以后导入或发布能力准备好后，目录会在这里出现；当前版本不会创建占位布局。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        x:Name="ErrorState"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="500"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="布局目录没有加载成功" />
                        <TextBlock
                            x:Name="ErrorMessageText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Click="OnRefresh"
                            Content="重新读取" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="DetailPanel"
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ScrollViewer>
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="描述详情" />
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Layout ID" />
                                <TextBlock x:Name="DetailLayoutId" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="修订与发布状态" />
                                <TextBlock x:Name="DetailRevisionStatus" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="兼容要求" />
                                <TextBlock x:Name="DetailCompatibility" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="变体" />
                                <TextBlock x:Name="DetailVariants" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="可移植身份" />
                                <TextBlock x:Name="DetailIdentities" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="显式绑定" />
                                <TextBlock x:Name="DetailBindings" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="BindSelectedLayoutButton"
                                AutomationProperties.HelpText="选择一个当前 Host 游戏，并明确保存或清除该游戏的布局绑定"
                                AutomationProperties.Name="管理所选布局的游戏绑定"
                                Click="OnManageBinding"
                                Content="绑定到游戏…"
                                HorizontalAlignment="Left" />
                            <Border
                                Padding="12"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="当前可管理已登记修订与游戏 UUID 的显式绑定。导入、发布、下载和画布编辑尚未进入 Host，不会在这里显示不可用按钮。"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
