{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligase.local/schemas/android-sync-v1.schema.json",
  "title": "Ligase Host Android Sync v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities", "library", "streaming"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hdrEncodingSupported"],
      "properties": {
        "hdrEncodingSupported": { "type": "boolean" }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "updatedAt", "sortMode", "items"],
      "properties": {
        "revision": { "$ref": "#/$defs/safeRevision" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "sortMode": {
          "enum": [
            "nameAscending",
            "nameDescending",
            "addedNewest",
            "addedOldest",
            "lastPlayedNewest",
            "manual"
          ]
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/libraryItem" }
        }
      }
    },
    "streaming": { "$ref": "#/$defs/streaming" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "portableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "const": "steam" },
        "id": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
        }
      }
    },
    "layoutBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "revision"],
      "properties": {
        "layoutId": { "$ref": "#/$defs/uuid" },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "libraryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "system",
        "publishedToClients",
        "addedAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["desktop", "virtualDesktop", "steam", "executable"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "steamAppId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "portableIdentity": { "$ref": "#/$defs/portableIdentity" },
        "layoutBinding": { "$ref": "#/$defs/layoutBinding" },
        "coverSha256": { "$ref": "#/$defs/sha256" },
        "coverSourceKind": {
          "enum": ["steamClientLibraryCache", "gameDbIgdb"]
        },
        "coverSourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "coverUsageRights": {
          "enum": [
            "thirdPartyArtworkLocalUseOnlyNoRedistribution",
            "thirdPartyArtworkLocalCacheOnly"
          ]
        },
        "system": { "type": "boolean" },
        "publishedToClients": { "type": "boolean" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastPlayedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "required": ["portableIdentity"] },
          "then": {
            "required": ["steamAppId"],
            "properties": { "kind": { "const": "steam" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "steam" } }, "required": ["kind"] },
          "then": { "required": ["steamAppId", "portableIdentity"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["steamAppId"] },
                { "required": ["portableIdentity"] }
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["coverSha256"] },
              { "required": ["coverSourceKind"] },
              { "required": ["coverSourceId"] },
              { "required": ["coverUsageRights"] }
            ]
          },
          "then": {
            "required": [
              "coverSha256",
              "coverSourceKind",
              "coverSourceId",
              "coverUsageRights"
            ]
          }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 240, "maximum": 16384 }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revision", "updatedAt", "globalResolution", "apps"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "revision": { "$ref": "#/$defs/safeRevision" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "globalResolution": { "$ref": "#/$defs/resolution" },
        "apps": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/uuid" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolution": { "$ref": "#/$defs/resolution" }
            }
          }
        }
      }
    }
  }
}
